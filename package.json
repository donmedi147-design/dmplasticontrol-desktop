{
  "name": "dmplasticontrol-desktop",
  "version": "1.0.0",
  "description": "Application Desktop DMPlastiControl - Gestion production plastique PEHD/PET",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "DMPlastiControl Team",
  "license": "PROPRIETARY",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test",
    "electron-start": "wait-on http://localhost:3000 && electron .",
    "start": "concurrently \"npm run react-start\" \"npm run electron-start\"",
    "build": "npm run react-build && npm run electron-builder",
    "electron-builder": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0",
    "socket.io-client": "^4.5.0",
    "@mui/material": "^5.14.0",
    "@mui/icons-material": "^5.14.0",
    "chart.js": "^4.4.0",
    "react-chartjs-2": "^5.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "electron": "^latest",
    "electron-builder": "^24.6.0",
    "react-scripts": "5.0.1"
  },
  "build": {
    "appId": "com.dmplasti.control",
    "productName": "DMPlastiControl",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "public/electron.js"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "public/icon.png",
      "category": "Office"
    }
  }
}
